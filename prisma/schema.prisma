generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  name     String
  products Product[]
}

model Product {
  id          Int      @id
  code        String   @unique @db.VarChar(10)
  name        String
  nameSortKey String   @db.Text
  description String
  image       String
  price       Int
  amount      Int
  date        DateTime @db.Timestamptz(3)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([nameSortKey, id])
  @@index([date(sort: Desc), id])
}