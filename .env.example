# Kontener PostgreSQL (używa go compose.yaml)
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=computer_shop
POSTGRES_TEST_DB=computer_shop_test

# Połączenia z hosta (localhost + opublikowany port).
# Znaki specjalne w haśle zakoduj procentowo (np. @ -> %40).
# Zmiennych bez prefiksu NEXT_PUBLIC_ nie widzi przeglądarka.
DATABASE_URL="postgresql://shop:change_me@localhost:5432/computer_shop"
TEST_DATABASE_URL="postgresql://shop:change_me@localhost:5433/computer_shop_test"